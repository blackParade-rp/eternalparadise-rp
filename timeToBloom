/* timeToBloom, by IKM */

.timetobloom {
    width: 700px;
    max-width: 100%;
    box-sizing: border-box;
    margin: 25px auto;
    background: var(--n1);
    color: var(--n4);
    overflow: hidden;
}

.timetobloom br {
    display: none;
}

.ttbhead {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    width: 100%;
    height: 210px;
    box-sizing: border-box;
    padding: 20px;
    background-color: var(--gg4);
    overflow: hidden;
}

.ttbhead::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    width: 400px;
    height: 185px;
    background-color: var(--n1);
    -webkit-mask-image: url("https://i.imgur.com/G9tAXii.png");
    mask-image: url("https://i.imgur.com/OZwoHR3.png");
    -webkit-mask-position: right bottom;
    mask-position: right bottom;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    pointer-events: none;
}

.ttbtitle {
    position: relative;
    z-index: 1;
    max-width: 65%;
    margin: 0;
    padding: 0;
    font-family: var(--f1);
    font-size: 38px;
    font-weight: 700;
    line-height: 1.15;
    text-align: left;
    color: #FFFFFF;
}

.ttbtext {
    box-sizing: border-box;
    padding: 40px 50px;
    font-family: var(--f2);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.8;
    text-align: justify;
    color: var(--n4);
}

.timetobloom .ttbtext br {
    display: initial;
}

.ttbtext b,
.ttbtext strong {
    color: var(--gg4);
    font-weight: 700;
}

.ttbtext u {
    color: var(--gg4);
    text-decoration: underline;
    text-decoration-color: var(--gg4);
    text-underline-offset: 3px;
}

.ttbfooter {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    width: 85%;
    box-sizing: border-box;
    margin: 0 auto 30px;
    padding: 15px 20px;
    border: 1px solid var(--gg4);
    font-family: "Courier New", monospace;
    font-size: 10px;
    line-height: 1.5;
    text-align: center;
    color: var(--n4);
}

.ttbfooter b,
.ttbfooter strong {
    color: var(--gg4);
    font-weight: 700;
}

.ttbseparator {
    color: var(--gg4);
    font-size: 14px;
    font-weight: 700;
}
